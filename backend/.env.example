###############################################################################
# Viking Restaurant Platform — Backend (Laravel API)
#
# Copy to `.env` and fill in real values. Never commit the resulting `.env`.
###############################################################################

APP_NAME="Viking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Baghdad
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Comma separated list of origins allowed to call the API and open websockets.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Restaurant defaults ---------------------------------------------------------
VIKING_CURRENCY=IQD
VIKING_CURRENCY_DECIMALS=0
VIKING_TAX_PERCENT=0
VIKING_SERVICE_CHARGE_PERCENT=0
VIKING_ALLOW_GUEST_ORDERS=true

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database --------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=viking
DB_USERNAME=viking
DB_PASSWORD=secret

# Session / Cache / Queue -----------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=viking

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail ------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@viking.local"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3 compatible: AWS S3, MinIO, DigitalOcean Spaces, R2) ------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=viking
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Reverb (websockets) ---------------------------------------------------------
REVERB_APP_ID=viking
REVERB_APP_KEY=viking-local-key
REVERB_APP_SECRET=viking-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Rate limiting (requests per minute) -----------------------------------------
RATE_LIMIT_API=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_ORDER=30

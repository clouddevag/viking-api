###############################################################################
# Viking Restaurant Platform — Docker Compose
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Generate APP_KEY with:  docker run --rm php:8.4-cli php -r \
#   "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
###############################################################################

# Application ------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Ports published on the host -------------------------------------------------
API_PORT=8000
FRONTEND_PORT=3000
REVERB_PUBLIC_PORT=8080

# Database ---------------------------------------------------------------------
DB_DATABASE=viking
DB_USERNAME=viking
DB_PASSWORD=change-me-in-production
DB_ROOT_PASSWORD=change-me-too

# Websockets -------------------------------------------------------------------
# REVERB_APP_KEY is public (it ships in the browser bundle).
# REVERB_APP_SECRET must stay private.
REVERB_APP_ID=viking
REVERB_APP_KEY=change-me-public-key
REVERB_APP_SECRET=change-me-private-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# First-boot behaviour ---------------------------------------------------------
RUN_MIGRATIONS=true
RUN_SEEDERS=true
# Password for the seeded demo accounts. Set this, or they get a documented
# default that is public knowledge.
VIKING_SEED_PASSWORD=

# Frontend build-time values (inlined into the client bundle) -------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hostname serving product images in production (S3/CDN). Leave blank locally.
NEXT_PUBLIC_MEDIA_HOSTNAME=
